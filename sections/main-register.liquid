<section class="section"><div class="wrap form-narrow">
  <h1 class="h1" style="text-align:center">Create account</h1>
  <div style="margin:1.25rem 0 2rem">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>

  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <label class="field"><span>First name</span>
      <input type="text" name="customer[first_name]" autocomplete="given-name"></label>
    <label class="field"><span>Last name</span>
      <input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    <label class="field"><span>Email</span>
      <input type="email" name="customer[email]" required autocomplete="email"></label>
    <label class="field"><span>Password</span>
      <input type="password" name="customer[password]" autocomplete="new-password"></label>
    <button class="btn btn--full" type="submit">Create account</button>
  {% endform %}

  <p style="text-align:center;margin-top:1.25rem;font-size:.9rem">
    Already have an account?
    <a href="{{ routes.account_login_url }}" style="border-bottom:1px solid currentColor">Log in</a>
  </p>
</div></section>

{% schema %}{ "name": "Register" }{% endschema %}
