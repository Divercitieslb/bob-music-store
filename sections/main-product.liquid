{%- comment -%}
  Product page.

  Enquiry-only behaviour is preserved exactly: when settings.enquiry_only is on,
  or the product price is 0, the page shows "Price on request" and a WhatsApp
  enquiry button instead of add-to-cart. Everything else — the Shopify product
  form, the quantity stepper (data-qty), the gallery hooks (data-gallery-main /
  data-gallery-thumb) that theme.js binds to — keeps working as before.
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign ask = false
  if settings.enquiry_only or product.price == 0
    assign ask = true
  endif
  assign media_count = product.media.size
-%}

<style>
  .pdp,.pdp-stage,.pdp-info,.buybar,.pdp-related{--e:cubic-bezier(.16,1,.3,1)}

  /* --- gallery -------------------------------------------------------------- */
  .pdp__gallery{gap:.85rem}
  .pdp-stage{position:relative;overflow:hidden}
  .pdp-stage img{
    transform-origin:var(--zx,50%) var(--zy,50%);
    transition:transform .5s var(--e);
    will-change:transform;
  }
  @media(hover:hover) and (pointer:fine){
    .pdp-stage[data-zoom]{cursor:zoom-in}
    .pdp-stage.is-zooming img{transform:scale(1.6);transition:transform .12s linear}
  }
  .pdp-stage__hint{
    position:absolute;right:.9rem;bottom:.9rem;z-index:2;
    display:inline-flex;align-items:center;gap:.45rem;
    padding:.42rem .7rem;background:rgba(20,16,12,.78);color:var(--bone);
    font-family:var(--f-sans);font-size:.56rem;font-weight:700;letter-spacing:.2em;
    text-transform:uppercase;pointer-events:none;
    opacity:0;transition:opacity .3s var(--e);
  }
  @media(hover:hover) and (pointer:fine){
    .pdp-stage[data-zoom] .pdp-stage__hint{opacity:.62}
    .pdp-stage.is-zooming .pdp-stage__hint{opacity:0}
  }
  @media(prefers-reduced-motion:reduce){
    .pdp-stage img{transform:none !important}
    .pdp-stage[data-zoom]{cursor:default}
  }

  .pdp__thumbrow{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .pdp__thumbs{flex-wrap:nowrap;overflow-x:auto;padding-bottom:.35rem;scrollbar-width:thin}
  .pdp__thumb{flex:0 0 auto;position:relative}
  .pdp__thumb::after{
    content:'';position:absolute;left:0;right:0;bottom:-.35rem;height:1px;
    background:var(--brass);transform:scaleX(0);transform-origin:left;
    transition:transform .34s var(--e);
  }
  .pdp__thumb[aria-current=true]::after{transform:scaleX(1)}
  .pdp__thumb:focus-visible{outline:2px solid var(--brass);outline-offset:2px}
  .pdp__counter{
    flex-shrink:0;font-family:var(--f-mono);font-size:.72rem;letter-spacing:.08em;
    color:var(--ink-40);white-space:nowrap;
  }
  .pdp__counter b{color:var(--ink);font-weight:400}

  /* --- info column ---------------------------------------------------------- */
  .pdp-info__head{display:grid;gap:.55rem}
  .pdp-info__head .eyebrow{margin:0}
  .pdp-info__head .h1{font-size:clamp(1.9rem,3.2vw,2.9rem);line-height:1.08}
  .pdp-price-row{display:flex;align-items:baseline;gap:1.1rem;flex-wrap:wrap}
  .pdp__price{margin:0}
  .pdp__ask-note{
    font-family:var(--f-sans);font-size:.63rem;font-weight:600;letter-spacing:.18em;
    text-transform:uppercase;color:var(--ink-40);
  }
  .pdp-buy{display:grid;gap:.7rem;margin-top:.35rem}
  .pdp-buy__row{display:flex;gap:.6rem;align-items:stretch}
  .pdp-buy__row .btn{flex:1}
  .pdp-note{
    display:flex;align-items:flex-start;gap:.6rem;
    font-size:.84rem;color:var(--ink-60);line-height:1.55;
  }
  .pdp-note svg{flex-shrink:0;margin-top:.15rem;color:var(--brass)}
  .pdp-trust{
    display:grid;gap:.7rem;padding:1.1rem 0;
    border-top:1px solid var(--rule-soft);border-bottom:1px solid var(--rule-soft);
  }
  .pdp-desc{margin-top:.25rem}
  .pdp-fullstop{display:flex;justify-content:center;padding:.4rem 0 .1rem;opacity:.75}
  .pdp-info__meta-sku{transition:opacity var(--t-fast)}

  /* --- sticky buy bar ------------------------------------------------------- */
  .buybar{
    position:fixed;left:0;right:0;bottom:0;z-index:70;
    background:rgba(251,248,242,.96);border-top:1px solid var(--rule);
    box-shadow:0 -12px 30px -26px rgba(20,16,12,.8);
    transform:translateY(100%);visibility:hidden;
    transition:transform .42s var(--e),visibility 0s linear .42s;
  }
  @supports (backdrop-filter:blur(6px)){.buybar{backdrop-filter:blur(10px)}}
  .buybar.is-on{
    transform:none;visibility:visible;
    transition:transform .42s var(--e),visibility 0s linear 0s;
  }
  @media(prefers-reduced-motion:reduce){
    .buybar,.buybar.is-on{transition-delay:0s}
  }
  .buybar__inner{
    display:flex;align-items:center;justify-content:space-between;gap:1rem;
    padding-block:.7rem;
  }
  .buybar__id{display:flex;align-items:center;gap:.85rem;min-width:0}
  .buybar__thumb{
    width:46px;height:46px;flex-shrink:0;background:var(--media);
    box-shadow:inset 0 0 0 1px var(--rule-soft);
  }
  .buybar__thumb img{width:100%;height:100%;object-fit:contain;padding:4px}
  .buybar__text{min-width:0}
  .buybar__title{
    font-family:var(--f-display);font-size:1.02rem;font-weight:600;line-height:1.2;
    margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .buybar__price{
    margin:.1rem 0 0;font-family:var(--f-mono);font-size:.76rem;letter-spacing:.02em;
    color:var(--ink-60);
  }
  .buybar__act{display:flex;align-items:center;gap:.5rem;flex-shrink:0}
  .buybar__act .btn{white-space:nowrap}
  @media(max-width:640px){
    .buybar__thumb{display:none}
    .buybar__title{max-width:42vw}
    .buybar__act .btn{padding-inline:1.1rem}
  }

  /* --- related -------------------------------------------------------------- */
  .pdp-related__head{display:grid;gap:.5rem;margin-bottom:1.9rem;max-width:520px}
  .pdp-related__orn{margin-top:.6rem;max-width:300px}
</style>

<div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a> <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>
</div>

<section class="section section--tight">
  <div class="wrap">
    <div class="pdp">

      <div class="pdp__gallery">
        <div class="pdp__main pdp-stage" data-gallery-main {% if product.featured_media %}data-zoom{% endif %}>
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 1400 }}"
                 srcset="{{ product.featured_media | image_url: width: 700 }} 700w,
                         {{ product.featured_media | image_url: width: 1400 }} 1400w,
                         {{ product.featured_media | image_url: width: 2048 }} 2048w"
                 sizes="(min-width:900px) 55vw, 96vw"
                 alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
                 width="1400" height="1400" loading="eager" fetchpriority="high">
            <span class="pdp-stage__hint">Hover to zoom</span>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if media_count > 1 -%}
          <div class="pdp__thumbrow">
            <div class="pdp__thumbs" role="group" aria-label="Product images">
              {%- for media in product.media -%}
                <button class="pdp__thumb" type="button"
                        data-gallery-thumb
                        data-media-id="{{ media.id }}"
                        data-index="{{ forloop.index }}"
                        data-full="{{ media | image_url: width: 2048 }}"
                        data-alt="{{ media.alt | escape | default: product.title | escape }}"
                        aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                        aria-label="View image {{ forloop.index }} of {{ media_count }}">
                  <img src="{{ media | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
            <p class="pdp__counter" aria-hidden="true">
              <b data-media-counter>01</b> / {{ media_count }}
            </p>
          </div>
        {%- endif -%}
      </div>

      <div class="pdp__info pdp-info">
        <div class="pdp-info__head">
          {%- if product.vendor != blank and product.vendor != 'Unbranded' and product.vendor != 'Generic' -%}
            <p class="eyebrow">{{ product.vendor }}</p>
          {%- endif -%}
          <h1 class="h1">{{ product.title }}</h1>
        </div>

        {% render 'ornament', name: 'divider', tone: 'brass' %}

        <div class="pdp-price-row">
          <p class="pdp__price" data-price>
            {%- if ask -%}
              <span class="price--ask">Price on request</span>
            {%- elsif product.compare_at_price > product.price -%}
              <span class="price--was">{{ product.compare_at_price | money }}</span>
              <span class="price--sale">{{ product.price | money }}</span>
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>
          {%- if ask -%}
            <span class="pdp__ask-note">We quote by hand</span>
          {%- endif -%}
        </div>

        <p class="stock {% unless product.available %}stock--out{% endunless %}" data-stock>
          {%- if product.available -%}
            {%- if v.inventory_quantity == 1 and v.inventory_management != blank -%}
              One only — last in stock
            {%- else -%}
              In stock, ready to ship
            {%- endif -%}
          {%- else -%}
            Sold — ask us about the next one
          {%- endif -%}
        </p>

        {%- form 'product', product, id: 'product-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="opt" style="margin-bottom:1.1rem">
                <span class="opt__label">{{ option.name }}</span>
                <div class="opt__values">
                  {%- for value in option.values -%}
                    {%- assign oid = 'opt-' | append: option.position | append: '-' | append: forloop.index -%}
                    <input type="radio" id="{{ oid }}" name="option{{ option.position }}"
                           value="{{ value | escape }}" data-option-input
                           {% if option.selected_value == value %}checked{% endif %}>
                    <label for="{{ oid }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="pdp-buy" data-buy-block>
            {%- if ask -%}
              {%- assign msg = 'Hello Bob Music — I would like a price for: ' | append: product.title -%}
              {%- if settings.whatsapp_number != blank -%}
                <a class="btn btn--full"
                   href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ msg | url_encode }}"
                   target="_blank" rel="noopener">
                  {% render 'icon', name: 'whatsapp', size: 18 %} Ask for a price
                </a>
              {%- endif -%}
              <a class="btn btn--ghost btn--full"
                 href="{{ routes.root_url }}pages/contact?subject={{ product.title | url_encode }}">Email an enquiry</a>
              <p class="pdp-note">
                {% render 'icon', name: 'note', size: 16 %}
                <span>Instruments like this are priced on condition and set-up. Message the shop and a player will answer with photographs and a price.</span>
              </p>
            {%- else -%}
              <div class="pdp-buy__row">
                <div class="qty">
                  <button type="button" data-qty="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                  <label class="visually-hidden" for="qty">Quantity</label>
                  <input id="qty" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                  <button type="button" data-qty="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
                </div>
                <button type="submit" class="btn" data-add-btn
                        {% unless product.available %}disabled aria-disabled="true"{% endunless %}>
                  {% if product.available %}Add to cart{% else %}Sold out{% endif %}
                </button>
              </div>
              {%- if product.available -%}
                {{ form | payment_button }}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endform -%}

        <div class="pdp-trust">
          <p class="pdp-note">
            {% render 'icon', name: 'tune', size: 16 %}
            <span>Checked, tuned and set up on our bench in Beirut before it leaves the shop.</span>
          </p>
          <p class="pdp-note">
            {% render 'icon', name: 'truck', size: 16 %}
            <span>Delivered across Lebanon. Hard case where the instrument needs one.</span>
          </p>
        </div>

        <dl class="pdp__meta">
          {%- if v.sku != blank -%}
            <div class="pdp-info__meta-sku" data-sku-row><dt>SKU</dt><dd class="num" data-sku>{{ v.sku }}</dd></div>
          {%- endif -%}
          {%- if product.type != blank -%}
            <div><dt>Type</dt><dd>{{ product.type }}</dd></div>
          {%- endif -%}
          {%- if product.vendor != blank and product.vendor != 'Unbranded' and product.vendor != 'Generic' -%}
            <div><dt>Brand</dt><dd>{{ product.vendor }}</dd></div>
          {%- endif -%}
        </dl>

        {%- if product.description != blank -%}
          <div class="rte pdp-desc">{{ product.description }}</div>
          <div class="pdp-fullstop">{% render 'ornament', name: 'khatam', tone: 'brass', size: 16 %}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="acc">
            {%- for block in section.blocks -%}
              {%- if block.type == 'accordion' -%}
                <details {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title }} {% render 'icon', name: 'chevron' %}</summary>
                  <div class="acc__body rte">{{ block.settings.content }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{%- comment -%} ---------------------------------------------------- sticky buy bar {%- endcomment -%}
<div class="buybar" data-buybar>
  <div class="wrap buybar__inner">
    <div class="buybar__id">
      {%- if product.featured_media -%}
        <span class="buybar__thumb">
          <img src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="120" height="120" loading="lazy">
        </span>
      {%- endif -%}
      <span class="buybar__text">
        <span class="buybar__title">{{ product.title }}</span>
        <span class="buybar__price num" data-buybar-price>
          {%- if ask -%}Price on request{%- else -%}{{ product.price | money }}{%- endif -%}
        </span>
      </span>
    </div>
    <div class="buybar__act">
      {%- if ask -%}
        {%- assign bmsg = 'Hello Bob Music — I would like a price for: ' | append: product.title -%}
        {%- if settings.whatsapp_number != blank -%}
          <a class="btn"
             href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ bmsg | url_encode }}"
             target="_blank" rel="noopener">
            {% render 'icon', name: 'whatsapp', size: 16 %} Ask for a price
          </a>
        {%- else -%}
          <a class="btn" href="{{ routes.root_url }}pages/contact?subject={{ product.title | url_encode }}">Enquire</a>
        {%- endif -%}
      {%- else -%}
        <button class="btn" type="submit" form="product-form" data-buybar-add
                {% unless product.available %}disabled aria-disabled="true"{% endunless %}>
          {% if product.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} ------------------------------------------------------------ related {%- endcomment -%}
{%- if section.settings.show_related -%}
  {%- liquid
    # Liquid does not allow a filter inside a bracket lookup — the key would
    # parse as the path product.type.handleize and resolve to nil. Compute the
    # handle first, then look it up.
    assign type_handle = product.type | handleize
    assign rel = collections[type_handle].products
    if rel == blank
      if collection != blank
        assign rel = collection.products
      endif
    endif
    if rel == blank
      for c in product.collections
        if c.handle != 'all'
          if c.products_count > 1
            assign rel = c.products
            break
          endif
        endif
      endfor
    endif

    assign rel_n = 0
    for p in rel limit: 12
      if p.id != product.id
        assign rel_n = rel_n | plus: 1
      endif
    endfor
  -%}

  {%- if rel_n > 0 -%}
    <section class="section section--shell pdp-related">
      <div class="wrap">
        <div class="pdp-related__head">
          <p class="eyebrow">More like this</p>
          <h2 class="h2">From the same bench</h2>
          <div class="pdp-related__orn">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>
        </div>
        <div class="grid grid--products" data-reveal-stagger>
          {%- assign shown = 0 -%}
          {%- for p in rel limit: 12 -%}
            {%- if p.id != product.id and shown < 4 -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Variant data for the option pickers. Money strings are formatted by Liquid so
  the browser never has to guess a currency format.
{%- endcomment -%}
<script type="application/json" data-variant-data>
[
  {%- for var in product.variants -%}
    {
      "id": {{ var.id }},
      "options": {{ var.options | json }},
      "available": {{ var.available | json }},
      "sku": {{ var.sku | json }},
      "media_id": {% if var.featured_media %}{{ var.featured_media.id }}{% else %}null{% endif %},
      "price": {{ var.price | money | json }},
      "compare": {% if var.compare_at_price > var.price %}{{ var.compare_at_price | money | json }}{% else %}null{% endif %},
      "last_one": {% if var.inventory_quantity == 1 and var.inventory_management != blank %}true{% else %}false{% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<script>
  (function () {
    'use strict';

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    /* ------------------------------------------------------- gallery zoom -- */
    var stage = document.querySelector('.pdp-stage[data-zoom]');
    if (stage) {
      var zoomOn = function () {
        return fine.matches && !reduce.matches;
      };
      stage.addEventListener('mouseenter', function () {
        if (zoomOn()) stage.classList.add('is-zooming');
      });
      stage.addEventListener('mousemove', function (e) {
        if (!zoomOn()) return;
        var r = stage.getBoundingClientRect();
        var x = ((e.clientX - r.left) / r.width) * 100;
        var y = ((e.clientY - r.top) / r.height) * 100;
        stage.style.setProperty('--zx', Math.max(0, Math.min(100, x)) + '%');
        stage.style.setProperty('--zy', Math.max(0, Math.min(100, y)) + '%');
      });
      stage.addEventListener('mouseleave', function () {
        stage.classList.remove('is-zooming');
        stage.style.setProperty('--zx', '50%');
        stage.style.setProperty('--zy', '50%');
      });
      reduce.addEventListener && reduce.addEventListener('change', function () {
        if (reduce.matches) stage.classList.remove('is-zooming');
      });
    }

    /* ------------------------------------------------------- media counter - */
    var counter = document.querySelector('[data-media-counter]');
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-gallery-thumb]'));
    function pad(n) { return n < 10 ? '0' + n : String(n); }
    if (counter && thumbs.length) {
      counter.textContent = pad(1);
      thumbs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          counter.textContent = pad(parseInt(btn.getAttribute('data-index'), 10) || 1);
        });
      });
    }

    /* ------------------------------------------------------ sticky buy bar - */
    var bar = document.querySelector('[data-buybar]');
    var buyBlock = document.querySelector('[data-buy-block]');
    if (bar && buyBlock && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var e = entries[0];
        var passed = !e.isIntersecting && e.boundingClientRect.top < 0;
        bar.classList.toggle('is-on', passed);
      }, { threshold: 0 }).observe(buyBlock);
    }

    /* ------------------------------------------------------ variant picker - */
    var form = document.getElementById('product-form');
    var dataEl = document.querySelector('[data-variant-data]');
    if (!form || !dataEl) return;

    var variants;
    try { variants = JSON.parse(dataEl.textContent); } catch (err) { return; }
    if (!variants || !variants.length) return;

    var idInput = form.querySelector('[data-variant-id]');
    var priceEl = document.querySelector('[data-price]');
    var barPriceEl = document.querySelector('[data-buybar-price]');
    var stockEl = document.querySelector('[data-stock]');
    var skuEl = document.querySelector('[data-sku]');
    var skuRow = document.querySelector('[data-sku-row]');
    var addBtns = Array.prototype.slice.call(document.querySelectorAll('[data-add-btn],[data-buybar-add]'));
    var main = document.querySelector('[data-gallery-main]');
    var isAsk = !!(priceEl && priceEl.querySelector('.price--ask'));

    function chosen() {
      var out = [];
      Array.prototype.forEach.call(form.querySelectorAll('[data-option-input]'), function (input) {
        if (!input.checked) return;
        var pos = parseInt(input.name.replace('option', ''), 10);
        if (pos > 0) out[pos - 1] = input.value;
      });
      return out;
    }

    function match(sel) {
      if (!sel.length) return null;
      for (var i = 0; i < variants.length; i++) {
        var ok = true;
        for (var j = 0; j < sel.length; j++) {
          if (sel[j] === undefined) continue;
          if (variants[i].options[j] !== sel[j]) { ok = false; break; }
        }
        if (ok) return variants[i];
      }
      return null;
    }

    function showMedia(mediaId) {
      if (!mediaId || !main) return;
      var thumb = document.querySelector('[data-gallery-thumb][data-media-id="' + mediaId + '"]');
      if (thumb) thumb.click();
    }

    function apply(variant) {
      if (!variant) {
        addBtns.forEach(function (b) {
          if (b.tagName !== 'BUTTON') return;
          b.disabled = true;
          b.setAttribute('aria-disabled', 'true');
          b.textContent = 'Unavailable';
        });
        return;
      }

      if (idInput) idInput.value = variant.id;

      if (!isAsk) {
        if (priceEl) {
          priceEl.innerHTML = variant.compare
            ? '<span class="price--was">' + variant.compare + '</span> <span class="price--sale">' + variant.price + '</span>'
            : variant.price;
        }
        if (barPriceEl) barPriceEl.innerHTML = variant.price;
      }

      if (stockEl) {
        stockEl.classList.toggle('stock--out', !variant.available);
        stockEl.textContent = variant.available
          ? (variant.last_one ? 'One only — last in stock' : 'In stock, ready to ship')
          : 'Sold — ask us about the next one';
      }

      if (skuEl && skuRow) {
        if (variant.sku) { skuEl.textContent = variant.sku; skuRow.style.display = ''; }
        else { skuRow.style.display = 'none'; }
      }

      addBtns.forEach(function (b) {
        if (b.tagName !== 'BUTTON') return;
        b.disabled = !variant.available;
        if (variant.available) b.removeAttribute('aria-disabled');
        else b.setAttribute('aria-disabled', 'true');
        b.textContent = variant.available ? 'Add to cart' : 'Sold out';
      });

      showMedia(variant.media_id);

      if (window.history && window.history.replaceState) {
        var u = new URL(window.location.href);
        u.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', u.toString());
      }
    }

    form.addEventListener('change', function (e) {
      if (!e.target || !e.target.hasAttribute || !e.target.hasAttribute('data-option-input')) return;
      apply(match(chosen()));
    });
  })();
</script>

