<section class="section section--tight {{ section.settings.bg }}{% if section.settings.bg contains 'ink' or section.settings.bg contains 'espresso' %} has-tessellation{% endif %}">
  {%- if section.settings.bg contains 'ink' or section.settings.bg contains 'espresso' -%}
    <span class="sec-tess" aria-hidden="true">
      {% render 'illustration', name: 'tile-pattern', tone: 'brass', size: 520, opacity: 0.16 %}
    </span>
  {%- endif -%}
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="props__head">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <div class="props__rule">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>
      </div>
    {%- endif -%}

    <div class="grid grid--4" data-reveal-stagger>
      {%- comment -%}
        Real classes, not inline styles. An inline declaration cannot be
        overridden from a stylesheet without !important, so while these lived in
        the style attribute the section could not be made denser on a phone at
        all — it stacked into 824px of one-column trust copy and there was no
        selector that could reach it.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="prop" data-reveal {{ block.shopify_attributes }}>
          <div class="prop__icon">{% render 'icon', name: block.settings.icon, size: 30 %}</div>
          <h3 class="h3 prop__title">{{ block.settings.title }}</h3>
          <p class="prop__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "bg", "label": "Background", "default": "section--shell",
      "options": [
        { "value": "", "label": "White" },
        { "value": "section--shell", "label": "Shell" },
        { "value": "section--ink", "label": "Ink" },
        { "value": "section--espresso", "label": "Espresso" }
      ] }
  ],
  "blocks": [
    { "type": "prop", "name": "Prop", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "tune",
        "options": [
          { "value": "tune", "label": "Set-up" },
          { "value": "truck", "label": "Delivery" },
          { "value": "shield", "label": "Guarantee" },
          { "value": "note", "label": "Music" },
          { "value": "whatsapp", "label": "WhatsApp" }
        ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Set up on the bench" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Every instrument is checked, tuned and adjusted before it leaves the shop." }
    ]}
  ],
  "presets": [{ "name": "Value props", "blocks": [ {"type":"prop"},{"type":"prop"},{"type":"prop"},{"type":"prop"} ] }]
}
{% endschema %}
