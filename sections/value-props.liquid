<section class="section section--tight {{ section.settings.bg }} {% if section.settings.bg contains 'ink' %}tile-bg{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div style="text-align:center;margin-bottom:2.5rem">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <div style="margin-top:1rem">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>
      </div>
    {%- endif -%}

    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        <div style="text-align:center;padding:1rem .5rem" {{ block.shopify_attributes }}>
          <div style="color:var(--brass);display:flex;justify-content:center;margin-bottom:.9rem">
            {% render 'icon', name: block.settings.icon, size: 30 %}
          </div>
          <h3 class="h3" style="font-size:1.25rem;margin-bottom:.45rem">{{ block.settings.title }}</h3>
          <p style="font-size:.92rem;color:{% if section.settings.bg contains 'ink' %}#CFC3B0{% else %}var(--ink-60){% endif %};margin:0">
            {{ block.settings.text }}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "bg", "label": "Background", "default": "section--shell",
      "options": [
        { "value": "", "label": "White" },
        { "value": "section--shell", "label": "Shell" },
        { "value": "section--ink", "label": "Ink" },
        { "value": "section--espresso", "label": "Espresso" }
      ] }
  ],
  "blocks": [
    { "type": "prop", "name": "Prop", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "tune",
        "options": [
          { "value": "tune", "label": "Set-up" },
          { "value": "truck", "label": "Delivery" },
          { "value": "shield", "label": "Guarantee" },
          { "value": "note", "label": "Music" },
          { "value": "whatsapp", "label": "WhatsApp" }
        ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Set up on the bench" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Every instrument is checked, tuned and adjusted before it leaves the shop." }
    ]}
  ],
  "presets": [{ "name": "Value props", "blocks": [ {"type":"prop"},{"type":"prop"},{"type":"prop"},{"type":"prop"} ] }]
}
{% endschema %}
