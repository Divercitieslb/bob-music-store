<section class="section section--tight">
  <div class="wrap">
    <p class="eyebrow">The catalogue</p>
    <h1 class="h1">Collections</h1>
    {% render 'ornament', name: 'divider', tone: 'brass' %}
  </div>
</section>

<div class="wrap" style="padding-bottom:clamp(3rem,6vw,5rem)">
  {%- paginate collections by 24 -%}
  <div class="grid grid--3">
    {%- for col in collections -%}
      {%- if col.products_count > 0 -%}
        <a class="tile" href="{{ col.url }}">
          {%- if col.featured_image -%}
            <img src="{{ col.featured_image | image_url: width: 700 }}" alt="{{ col.title | escape }}"
                 width="700" height="875" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="tile__label">
            <h3>{{ col.title }}</h3>
            <span>{{ col.products_count }} product{% if col.products_count != 1 %}s{% endif %}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pagination">
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
        {%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Collections list" }
{% endschema %}
