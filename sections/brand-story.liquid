<section class="section {{ section.settings.bg }}">
  <div class="wrap">
    <div class="grid grid--2" style="align-items:center;gap:clamp(2rem,5vw,5rem)">

      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h1" style="margin-bottom:1.25rem">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.cta_label != blank -%}
          <a class="btn {% if section.settings.bg == 'section--ink' %}btn--light{% else %}btn--ghost{% endif %}"
             href="{{ section.settings.cta_url }}" style="margin-top:1.5rem">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>

      <div>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                       {{ section.settings.image | image_url: width: 1200 }} 1200w"
               sizes="(min-width:900px) 45vw, 92vw"
               alt="{{ section.settings.image_alt | escape }}"
               width="1200" height="900" loading="lazy" style="width:100%">
        {%- else -%}
          <div style="background:var(--shell);aspect-ratio:4/3;display:grid;place-items:center">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A counter, a bench, and someone who plays" },
    { "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>Bob Music sits where two musical worlds overlap. On one wall, hand-inlaid darbukas and ouds built by makers in Egypt, Syria and Lebanon. On the other, the guitars, microphones and pedals any working band needs on a Friday night.</p><p>We do not drop-ship. Everything here has been unboxed, checked and set up by hand — and if it needs a fret dressed or a head tuned before it leaves, that happens first.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Inside the Bob Music shop" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Our story" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "select", "id": "bg", "label": "Background", "default": "section--shell",
      "options": [
        { "value": "", "label": "White" },
        { "value": "section--shell", "label": "Shell" },
        { "value": "section--ink", "label": "Ink" }
      ] }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
