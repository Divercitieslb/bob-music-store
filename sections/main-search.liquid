<section class="section section--tight">
  <div class="wrap">
    <h1 class="h1">{% if search.performed %}Results{% else %}Search{% endif %}</h1>
    {% render 'ornament', name: 'divider', tone: 'brass' %}
    <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:1.5rem;max-width:640px">
      <input type="hidden" name="type" value="product">
      <div style="display:flex;gap:.5rem">
        <label class="visually-hidden" for="q">Search</label>
        <input id="q" type="search" name="q" value="{{ search.terms | escape }}"
               placeholder="Oud, darbuka, Shure&hellip;"
               style="flex:1;padding:.9rem 1rem;border:1px solid var(--rule);background:var(--paper)">
        <button class="btn" type="submit">Search</button>
      </div>
    </form>
  </div>
</section>

<div class="wrap" style="padding-bottom:clamp(3rem,6vw,5rem)">
  {%- if search.performed -%}
    <p class="mono" style="color:var(--ink-60);margin-bottom:1.5rem">
      {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;
    </p>
    {%- paginate search.results by 24 -%}
      {%- if search.results.size > 0 -%}
        <div class="grid grid--products">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="empty">
          <h2 class="h2">No matches</h2>
          <p class="lede" style="margin-inline:auto">Nothing came back for that. Try a shorter word, or browse by instrument.</p>
          <a class="btn btn--ghost" href="{{ routes.collections_url }}">Browse collections</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search" }
{% endschema %}
