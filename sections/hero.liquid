{%- liquid
  assign ov = section.settings.overlay | divided_by: 100.0
  assign ov_edge = section.settings.overlay | plus: 26
  if ov_edge > 100
    assign ov_edge = 100
  endif
  assign ov_far = section.settings.overlay | times: 0.3
  assign ov2 = ov_edge | divided_by: 100.0
  assign ov3 = ov_far | divided_by: 100.0
  assign align = section.settings.align | default: 'left'
  assign height = section.settings.height | default: 'medium'
  assign cue_id = section.id | append: '-next'
-%}

<style>
  #shopify-section-{{ section.id }} .hero--cinema{
    --e-out:cubic-bezier(.16,1,.3,1);
    --ov-near:{{ ov2 }};
    --ov-mid:{{ ov }};
    --ov-far:{{ ov3 }};
    position:relative;isolation:isolate;
    background:var(--ink);color:var(--bone);overflow:hidden;
  }
  /* base.css paints a fixed scrim on .hero::after — this hero owns its own
     layered veil instead, so switch the inherited one off. */
  #shopify-section-{{ section.id }} .hero--cinema::after{content:none}

  /* ------------------------------------------------------------ the stage */
  .hero__stage{position:absolute;inset:0;z-index:0;pointer-events:none}

  /* Parallax layers are oversized so the drift can never expose an edge.
     motion.js shifts by (viewH/2 - elementCentre) * speed, so peak travel is
     roughly speed x (viewH + heroH)/2 — at speed .12 on a 740px hero in a 900px
     window that is ~98px. inset:-20% of the hero height is ~148px of headroom
     each way, which clears it with room to spare. Lower the inset only if you
     also lower data-parallax. */
  .hero__layer{position:absolute;inset:-20% 0;will-change:transform}
  .hero__layer img{width:100%;height:100%;object-fit:cover;display:block}
  .hero__layer--back img{opacity:.66}

  .hero__layer--fore{
    inset:auto;bottom:-14%;width:min(46%,620px);
    {% if section.settings.layer_position == 'left' %}left:-3%;{% else %}right:-2%;{% endif %}
    opacity:.9;
  }
  .hero__layer--fore img{
    height:auto;width:100%;
    -webkit-mask-image:linear-gradient(to top,transparent 0%,#000 22%,#000 100%);
            mask-image:linear-gradient(to top,transparent 0%,#000 22%,#000 100%);
  }

  /* directional veil — heaviest behind the copy, clearing toward the far edge */
  .hero__veil{
    position:absolute;inset:0;
    background:linear-gradient(
      {% if align == 'centre' %}180deg{% else %}100deg{% endif %},
      rgba(20,16,12,var(--ov-near)) 0%,
      rgba(20,16,12,var(--ov-mid)) 46%,
      rgba(20,16,12,var(--ov-far)) 100%);
  }
  .hero__vignette{
    position:absolute;inset:0;
    background:radial-gradient(120% 90% at 50% 45%,transparent 42%,rgba(20,16,12,.55) 100%);
  }
  /* a warm brass bloom, as if a bulb were on over the bench */
  .hero__glow{
    position:absolute;inset:0;
    background:radial-gradient(46% 52% at {% if align == 'centre' %}50% 32%{% else %}76% 30%{% endif %},
      rgba(176,133,74,.24) 0%,transparent 68%);
    mix-blend-mode:screen;
  }

  /* ------------------------------------------------------------- ornament */
  .hero__orn{position:absolute;pointer-events:none}
  .hero__orn--corner{
    top:clamp(1rem,3vw,2.4rem);right:clamp(1rem,3vw,2.4rem);
    transform:scaleX(-1);opacity:.45;
  }
  .hero__orn--band{
    left:0;right:0;bottom:0;opacity:.3;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent);
  }

  /* -------------------------------------------------------------- content */
  #shopify-section-{{ section.id }} .hero__inner{
    position:relative;z-index:2;
    max-width:var(--w-max);margin-inline:auto;
    padding:clamp(4rem,11vw,8rem) var(--pad) clamp(5.5rem,12vw,9rem);
    display:flex;flex-direction:column;
    {% if align == 'centre' %}align-items:center;text-align:center;{% endif %}
    justify-content:{% if align == 'centre' %}center{% else %}flex-end{% endif %};
  }
  {% case height %}
    {% when 'short' %}
      #shopify-section-{{ section.id }} .hero__inner{min-height:clamp(340px,46vh,500px)}
    {% when 'tall' %}
      #shopify-section-{{ section.id }} .hero__inner{min-height:clamp(560px,82vh,900px)}
    {% when 'full' %}
      #shopify-section-{{ section.id }} .hero__inner{
        min-height:calc(100vh - var(--header-h));
        min-height:calc(100svh - var(--header-h));
      }
    {% else %}
      #shopify-section-{{ section.id }} .hero__inner{min-height:clamp(440px,66vh,720px)}
  {% endcase %}

  #shopify-section-{{ section.id }} .hero__content{
    max-width:{% if align == 'centre' %}56ch{% else %}min(660px,90%){% endif %};
  }
  .hero__eyebrow{
    display:flex;align-items:center;gap:.6rem;color:var(--brass);
    {% if align == 'centre' %}justify-content:center;{% endif %}
  }
  .hero__eyebrow .orn--khatam{flex:0 0 auto}
  .hero__title{margin:0}
  #shopify-section-{{ section.id }} .hero .lede{color:#DACFBE;margin-bottom:0}
  .hero__cta{display:flex;gap:.85rem;flex-wrap:wrap;margin-top:clamp(1.6rem,3vw,2.4rem)}
  {% if align == 'centre' %}.hero__cta{justify-content:center}{% endif %}

  /* ------------------------------------------------------------ scroll cue */
  /* The cue sits in a full-width rail rather than being centred with
     translateX(-50%): heroRise ends on transform:none, which would otherwise
     yank a centred cue back to the left edge as the animation lands. */
  .hero__cue-wrap{
    position:absolute;z-index:3;left:0;right:0;bottom:clamp(1.1rem,3vw,2rem);
    display:flex;padding-inline:var(--pad);pointer-events:none;
    justify-content:{% if align == 'centre' %}center{% else %}flex-start{% endif %};
  }
  .hero__cue{
    pointer-events:auto;
    display:inline-flex;align-items:center;gap:.75rem;
    font-family:var(--f-sans);font-size:.62rem;font-weight:600;
    letter-spacing:.24em;text-transform:uppercase;color:var(--sand);
    transition:color var(--t-fast);
  }
  .hero__cue:hover{color:var(--bone)}
  .hero__cue-rail{
    position:relative;display:block;width:1px;height:48px;
    background:linear-gradient(180deg,rgba(198,180,144,.5),rgba(198,180,144,0));
  }
  .hero__cue-dot{
    position:absolute;left:50%;top:0;width:5px;height:5px;margin-left:-2px;
    border-radius:50%;background:var(--brass);
    animation:heroCue 2.6s var(--e-out) infinite;
  }
  @keyframes heroCue{
    0%{transform:translateY(0);opacity:0}
    18%{opacity:1}
    72%{transform:translateY(42px);opacity:0}
    100%{transform:translateY(42px);opacity:0}
  }
  .hero__anchor{display:block;height:0;scroll-margin-top:calc(var(--header-h) + 8px)}

  /* ------------------------------------------------------------- entrance */
  /* Base state is VISIBLE. The keyframe starts from hidden, so if the animation
     never runs (no JS class, reduced motion, old browser) the copy is simply
     there. Gated on html.js so a JS-off visitor never sees a hidden frame. */
  @keyframes heroRise{
    from{opacity:0;transform:translateY(28px)}
    to{opacity:1;transform:none}
  }
  .js .hero__eyebrow{animation:heroRise .9s var(--e-out) both;animation-delay:.05s}
  .js .hero__content .lede{animation:heroRise .9s var(--e-out) both;animation-delay:.34s}
  .js .hero__cta{animation:heroRise .9s var(--e-out) both;animation-delay:.44s}
  .js .hero__cue{animation:heroRise .9s var(--e-out) both;animation-delay:.62s}

  /* Heading fallback. [data-split] is a hook for the word-by-word rise in
     motion.js, which replaces the text node with .split-line > .split-word and
     flips .is-in. Until that has happened the whole line rises as one piece;
     :has(*) means the two can never play on top of each other, and if motion.js
     is absent entirely this is the animation the heading gets. */
  .js .hero__title[data-split]:not(.is-in):not(:has(*)){
    animation:heroRise .95s var(--e-out) both;animation-delay:.16s;
  }

  /* --------------------------------------------------- reduced motion guard */
  /* base.css only crushes *-duration. Infinite keyframes at .01ms would strobe,
     and animation-delay is untouched — both have to be killed explicitly. */
  @media(prefers-reduced-motion:reduce){
    .hero__cue-dot{animation:none;top:20px;opacity:1}
    .js .hero__eyebrow,
    .js .hero__content .lede,
    .js .hero__cta,
    .js .hero__cue,
    .js .hero__title[data-split]{
      animation:none!important;animation-delay:0s!important;
      opacity:1;transform:none;
    }
    /* whatever the split script injects must not animate either, and its own
       inline opacity:0 has to lose — hence !important on the children */
    .hero__title[data-split] *{
      animation:none!important;transition:none!important;
      animation-delay:0s!important;transition-delay:0s!important;
      opacity:1!important;transform:none!important;
    }
    .hero__layer{transform:none!important}
  }

  /* ------------------------------------------------------------- narrow -- */
  @media(max-width:800px){
    .hero__layer--fore{display:none}
    .hero__orn--corner{display:none}
    #shopify-section-{{ section.id }} .hero__inner{padding-bottom:clamp(5rem,18vw,7rem)}
  }
</style>

<section class="hero hero--cinema hero--h-{{ height }}" data-hero>

  <div class="hero__stage" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {%- comment -%} data-parallax carries the speed itself — motion.js parseFloats the attribute value {%- endcomment -%}
      <div class="hero__layer hero__layer--back" data-parallax="0.12">
        <img src="{{ section.settings.image | image_url: width: 2400 }}"
             srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                     {{ section.settings.image | image_url: width: 1600 }} 1600w,
                     {{ section.settings.image | image_url: width: 2400 }} 2400w"
             sizes="100vw" alt="" width="2400" height="1350"
             loading="eager" fetchpriority="high" decoding="async">
      </div>
    {%- elsif section.settings.default_asset != blank -%}
      {%- comment -%}
        image_picker reads Content > Files and can never see artwork shipped in
        the theme, so packaged photography needs its own branch.
      {%- endcomment -%}
      <div class="hero__layer hero__layer--back" data-parallax="0.12">
        <img src="{{ section.settings.default_asset | asset_url }}"
             alt="" width="2200" height="1228"
             loading="eager" fetchpriority="high" decoding="async">
      </div>
    {%- endif -%}

    {%- if section.settings.layer_image != blank -%}
      {%- comment -%} negative speed: the near layer counter-drifts, which is what reads as depth {%- endcomment -%}
      <div class="hero__layer hero__layer--fore" data-parallax="-0.07">
        <img src="{{ section.settings.layer_image | image_url: width: 1200 }}"
             srcset="{{ section.settings.layer_image | image_url: width: 600 }} 600w,
                     {{ section.settings.layer_image | image_url: width: 1200 }} 1200w"
             sizes="(min-width:800px) 46vw, 0px" alt=""
             width="1200" height="1500" loading="lazy" decoding="async">
      </div>
    {%- endif -%}

    <div class="hero__veil"></div>
    <div class="hero__vignette"></div>
    <div class="hero__glow"></div>

    {%- if section.settings.show_ornament -%}
      <div class="hero__orn hero__orn--corner">
        {% render 'ornament', name: 'corner', tone: 'brass', size: 96 %}
      </div>
      {%- comment -%}
        The band is an edge treatment, not a depth layer — it stays welded to the
        bottom edge. Parallaxing a 24px strip anchored at bottom:0 just clips it
        out of the frame.
      {%- endcomment -%}
      <div class="hero__orn hero__orn--band">
        {% render 'ornament', name: 'band', tone: 'brass', size: 24 %}
      </div>
    {%- endif -%}
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow">
          {% render 'ornament', name: 'khatam', tone: 'brass', size: 13 %}
          <span>{{ section.settings.eyebrow }}</span>
        </p>
      {%- endif -%}

      {%- comment -%}
        Plain text inside the h1: with JS off or the split script absent this is
        an ordinary, fully visible heading. [data-split] is only a hook.
      {%- endcomment -%}
      {%- comment -%} data-split's value is the per-word stagger in ms {%- endcomment -%}
      <h1 class="h-display hero__title" data-split="70">{{ section.settings.heading }}</h1>

      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="hero__cta">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn btn--light" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--outline-light" href="{{ section.settings.cta2_url | default: routes.collections_url }}">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_cue -%}
    <div class="hero__cue-wrap">
      <a class="hero__cue" href="#{{ cue_id }}">
        <span>{{ section.settings.cue_label | default: 'Scroll' }}</span>
        <span class="hero__cue-rail" aria-hidden="true"><span class="hero__cue-dot"></span></span>
      </a>
    </div>
  {%- endif -%}

</section>

{%- if section.settings.show_cue -%}
  <span class="hero__anchor" id="{{ cue_id }}" aria-hidden="true"></span>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Imagery" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Drifts slowly behind the copy. Overrides the packaged image below." },
    { "type": "text", "id": "default_asset", "label": "Packaged image", "default": "hero-shop.jpg", "info": "A filename from the theme's assets folder, used when no image is chosen above." },
    { "type": "image_picker", "id": "layer_image", "label": "Foreground layer", "info": "Optional second image that moves at a different rate for depth. Hidden under 800px." },
    {
      "type": "select", "id": "layer_position", "label": "Foreground layer side",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "range", "id": "overlay", "label": "Overlay strength", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 60 },
    { "type": "checkbox", "id": "show_ornament", "label": "Show Levantine ornament", "default": true },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Beirut · Since 1978" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where the oud meets the amplifier." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two hundred and sixty instruments under one roof — hand-inlaid darbukas and Egyptian ouds beside Fender, Shure and BOSS. Set up on the bench, played before it ships." },
    {
      "type": "select", "id": "align", "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "centre", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Tall" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "tall"
    },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop the catalogue" },
    { "type": "url", "id": "cta_url", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Arabic instruments" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" },

    { "type": "header", "content": "Scroll cue" },
    { "type": "checkbox", "id": "show_cue", "label": "Show scroll cue", "default": true },
    { "type": "text", "id": "cue_label", "label": "Scroll cue label", "default": "Scroll" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
