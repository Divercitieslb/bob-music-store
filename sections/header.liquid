{%- liquid
  assign menu = linklists[section.settings.menu]
-%}

{%- comment -%}
  Header — grid layout is LOAD BEARING and must not change:
    row 1 .header__bar  = burger | logo | actions
    row 2 .header__nav  = full-width nav row of its own
  Nine mega-menu triggers used to collide with the icons when they shared a row.
  Everything added below (condense-on-scroll, mega stagger, scroll progress) is
  layered on top of that structure, never inside it.
{%- endcomment -%}

<style>
  /* ---------------------------------------------------------------- tokens */
  .header{
    /* editorial ease — longer + decelerating than the 180ms UI ease */
    --e-out:cubic-bezier(.16,1,.3,1);
    --hh:var(--header-h);
    --logo-w:clamp(132px,13vw,186px);
    --nav-pad:1.05rem;
    transition:background var(--t-med);
  }

  /* -------------------------------------------------------- condense state */
  .header.is-condensed{
    --hh:60px;
    --logo-w:clamp(104px,9vw,138px);
    --nav-pad:.6rem;
    background:rgba(251,248,242,.93);   /* --paper at 93% */
    backdrop-filter:saturate(1.15) blur(9px);
    -webkit-backdrop-filter:saturate(1.15) blur(9px);
  }
  .header__bar{
    min-height:var(--hh);
    transition:min-height .42s var(--e-out);
  }
  .header__logo img{
    width:var(--logo-w);
    transition:width .42s var(--e-out);
  }
  .header__nav .nav__link{
    padding-block:var(--nav-pad);
    transition:padding .42s var(--e-out),color var(--t-fast);
  }
  .header.is-condensed .header__nav{border-top-color:transparent}

  /* Brass hairline that fades in once the page has moved. Deliberately a
     pseudo-element, not box-shadow — theme.js writes an inline box-shadow on
     this element and an inline style would win over anything declared here. */
  .header::after{
    content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;
    background:linear-gradient(90deg,
      rgba(198,180,144,0) 0%,
      rgba(198,180,144,.7) 18%,
      var(--brass) 50%,
      rgba(198,180,144,.7) 82%,
      rgba(198,180,144,0) 100%);
    opacity:0;transition:opacity .5s var(--e-out);pointer-events:none;z-index:2;
  }
  .header.is-condensed::after{opacity:.95}

  /* ------------------------------------------------------- scroll progress */
  /* Direct scroll-position feedback (a scrollbar, not a decoration): it has no
     keyframes and no transition, so nothing "plays". Still reduced to a static
     hairline under prefers-reduced-motion, below. */
  .header__progress{
    position:absolute;left:0;right:0;bottom:-1px;height:2px;
    transform:scaleX(var(--sp,0));transform-origin:left center;
    background:linear-gradient(90deg,var(--oud),var(--brass) 60%,var(--sand));
    pointer-events:none;z-index:3;will-change:transform;
  }

  /* ------------------------------------------------------------- mega menu */
  .mega{
    transform:translateY(-14px);
    transition:opacity .34s var(--e-out),transform .44s var(--e-out),visibility .44s var(--e-out);
  }
  .nav__item:hover>.mega,
  .nav__item:focus-within>.mega{transform:none}

  /* brass rule that wipes across the top edge of the open panel */
  .mega::before{
    content:'';position:absolute;top:-1px;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,var(--brass),transparent);
    transform:scaleX(0);transform-origin:center;
    transition:transform .6s var(--e-out);
  }
  .nav__item:hover>.mega::before,
  .nav__item:focus-within>.mega::before{transform:scaleX(1)}

  /* columns stagger in; they close together (delay lives only in the open rule) */
  .mega__col,.mega__feature{
    opacity:0;transform:translateY(15px);
    transition:opacity .5s var(--e-out),transform .5s var(--e-out);
  }
  .nav__item:hover>.mega .mega__col,
  .nav__item:hover>.mega .mega__feature,
  .nav__item:focus-within>.mega .mega__col,
  .nav__item:focus-within>.mega .mega__feature{
    opacity:1;transform:none;
    transition-delay:calc(70ms + var(--i,0) * 55ms);
  }

  .mega__col h3{position:relative;display:inline-block;padding-bottom:.45rem}
  .mega__col h3::after{
    content:'';position:absolute;left:0;bottom:0;width:22px;height:1px;
    background:var(--brass);opacity:.5;
  }

  .mega__feature{position:relative;overflow:hidden}
  .mega__feature .orn--corner{
    position:absolute;top:0;right:0;transform:scaleX(-1);opacity:.5;pointer-events:none;
  }
  .mega__feature > *{position:relative;z-index:1}

  /* --------------------------------------------------- reduced motion guard */
  /* base.css crushes transition-duration globally, but NOT transition-delay —
     an un-zeroed 400ms stagger delay reads as lag, not calm. */
  @media(prefers-reduced-motion:reduce){
    .header__bar,.header__logo img,.header__nav .nav__link,
    .header::after,.mega,.mega::before,.mega__col,.mega__feature{
      transition:none!important;transition-delay:0s!important;
    }
    .mega{transform:none}
    .mega::before{transform:scaleX(1)}
    .mega__col,.mega__feature{opacity:1;transform:none}
    .header__progress{transform:none;height:1px;opacity:.35}
  }
</style>

<header class="header" data-header>
  <div class="wrap">
    <div class="header__bar">

      <button class="icon-btn header__burger" data-open="menu-drawer" aria-label="Open menu" aria-expanded="false">
        {% render 'icon', name: 'menu', size: 22 %}
      </button>

      <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 560 }}"
               alt="{{ shop.name }}" width="280" height="180" loading="eager">
        {%- else -%}
          <img src="{{ 'logo-header.png' | asset_url }}" alt="{{ shop.name }}"
               width="1139" height="732" loading="eager" fetchpriority="high">
        {%- endif -%}
      </a>

      <div class="header__actions">
        <button class="icon-btn" data-open="search-drawer" aria-label="Search" aria-expanded="false">
          {% render 'icon', name: 'search', size: 21 %}
        </button>
        {%- if shop.customer_accounts_enabled -%}
          <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
            {% render 'icon', name: 'user', size: 21 %}
          </a>
        {%- endif -%}
        <a class="icon-btn" href="{{ routes.cart_url }}"
           aria-label="Cart ({{ cart.item_count }} items)">
          {% render 'icon', name: 'cart', size: 21 %}
          <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </div>

  <nav class="header__nav" aria-label="Main">
    <div class="wrap">
      <ul class="nav">
          {%- for link in menu.links -%}
            <li class="nav__item">
              <a class="nav__link" href="{{ link.url }}"
                 {% if link.active %}aria-current="page"{% endif %}>
                {{ link.title }}
                {%- if link.links.size > 0 %} {% render 'icon', name: 'chevron' %}{% endif -%}
              </a>

              {%- if link.links.size > 0 -%}
                <div class="mega">
                  <div class="mega__inner">
                    {%- for child in link.links -%}
                      <div class="mega__col" style="--i:{{ forloop.index0 }}">
                        <h3>{{ child.title }}</h3>
                        {%- if child.links.size > 0 -%}
                          <ul class="mega__list">
                            {%- for gc in child.links -%}
                              <li><a href="{{ gc.url }}">{{ gc.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- else -%}
                          <ul class="mega__list">
                            <li><a href="{{ child.url }}">Shop all {{ child.title | downcase }}</a></li>
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}

                    {%- if section.settings.mega_feature_heading != blank -%}
                      <div class="mega__feature" style="--i:{{ link.links.size }}">
                        {% render 'ornament', name: 'corner', tone: 'brass', size: 58 %}
                        <p class="eyebrow">{{ section.settings.mega_feature_eyebrow }}</p>
                        <h3 class="h3">{{ section.settings.mega_feature_heading }}</h3>
                        <p>{{ section.settings.mega_feature_text }}</p>
                        <a class="link-arrow" href="{{ section.settings.mega_feature_url }}">
                          Explore {% render 'icon', name: 'arrow' %}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
      </ul>
    </div>
  </nav>

  {%- if section.settings.show_progress -%}
    <div class="header__progress" data-header-progress aria-hidden="true"></div>
  {%- endif -%}
</header>

{%- comment -%} ---------------------------------------------- mobile menu {%- endcomment -%}
<div class="drawer" id="menu-drawer" aria-hidden="true">
  <div class="drawer__scrim" data-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__head">
      <span class="mono">Menu</span>
      <button class="icon-btn" data-close aria-label="Close menu">{% render 'icon', name: 'close', size: 22 %}</button>
    </div>
    <div class="drawer__body">
      <ul class="m-nav">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details>
                <summary>{{ link.title }} {% render 'icon', name: 'chevron' %}</summary>
                <ul class="m-sub">
                  <li><a href="{{ link.url }}"><strong>Shop all {{ link.title | downcase }}</strong></a></li>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- for gc in child.links -%}
                      <li><a href="{{ gc.url }}" style="padding-left:1rem">{{ gc.title }}</a></li>
                    {%- endfor -%}
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="drawer__foot">
      {%- if settings.whatsapp_number != blank -%}
        <a class="btn btn--full" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}">
          {% render 'icon', name: 'whatsapp', size: 18 %} Message the shop
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} ---------------------------------------------------- search {%- endcomment -%}
<div class="drawer drawer--right" id="search-drawer" aria-hidden="true">
  <div class="drawer__scrim" data-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Search">
    <div class="drawer__head">
      <span class="mono">Search</span>
      <button class="icon-btn" data-close aria-label="Close search">{% render 'icon', name: 'close', size: 22 %}</button>
    </div>
    <div class="drawer__body">
      <form action="{{ routes.search_url }}" method="get" role="search" data-search-form>
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="search-input">Search products</label>
        <div style="display:flex;gap:.5rem">
          <input id="search-input" type="search" name="q" placeholder="Oud, darbuka, Shure&hellip;"
                 autocomplete="off" data-search-input
                 style="flex:1;padding:.9rem 1rem;border:1px solid var(--rule);background:var(--paper)">
          <button class="btn btn--sm" type="submit">Go</button>
        </div>
      </form>
      <div data-search-results style="margin-top:1.5rem"></div>
      {%- if section.settings.search_suggestions != blank -%}
        <div style="margin-top:2rem">
          <p class="eyebrow eyebrow--muted">Popular</p>
          <div class="chiprow">
            {%- assign terms = section.settings.search_suggestions | split: ',' -%}
            {%- for t in terms -%}
              <a class="chip" href="{{ routes.search_url }}?q={{ t | strip | url_encode }}">{{ t | strip }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  /* Header condense + scroll progress.
     No-JS: the header simply never condenses and the progress rail stays at 0 —
     nothing is hidden behind either behaviour. */
  (function () {
    var h = document.querySelector('[data-header]');
    if (!h || h.getAttribute('data-header-init')) return;
    h.setAttribute('data-header-init', '1');

    var rail = h.querySelector('[data-header-progress]');
    var condense = {{ section.settings.condense | json }};
    var ticking = false;
    var lastP = -1;

    function frame() {
      ticking = false;
      var y = window.pageYOffset || document.documentElement.scrollTop || 0;

      if (condense) {
        var on = y > 26;
        if (on !== h.classList.contains('is-condensed')) h.classList.toggle('is-condensed', on);
      }

      if (rail) {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var p = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
        if (Math.abs(p - lastP) > 0.001) { rail.style.setProperty('--sp', p.toFixed(4)); lastP = p; }
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(frame);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    frame();
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the built-in Bob Music logo." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "condense", "label": "Condense on scroll", "default": true, "info": "Shrinks the bar and logo and adds a brass hairline once the page moves." },
    { "type": "checkbox", "id": "show_progress", "label": "Show reading-progress rail", "default": true },
    { "type": "header", "content": "Mega menu feature panel" },
    { "type": "text", "id": "mega_feature_eyebrow", "label": "Eyebrow", "default": "Since 1978" },
    { "type": "text", "id": "mega_feature_heading", "label": "Heading", "default": "Come and play it first" },
    { "type": "textarea", "id": "mega_feature_text", "label": "Text", "default": "Every instrument is set up on the bench before it leaves us." },
    { "type": "url", "id": "mega_feature_url", "label": "Link" },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "search_suggestions", "label": "Popular searches", "info": "Comma separated.", "default": "Oud, Darbuka, Accordion, Shure, Strings" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
