<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">

      <div class="footer__brand">
        <div class="footer__lockup">
          <img src="{{ 'mark.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy" aria-hidden="true">
          <p class="nm">BOB</p>
          <p class="tg">All instruments. One passion.</p>
        </div>
        {%- if section.settings.blurb != blank -%}
          <p>{{ section.settings.blurb }}</p>
        {%- endif -%}

        <div class="social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="me noopener" target="_blank">{% render 'icon', name: 'instagram', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="me noopener" target="_blank">{% render 'icon', name: 'facebook', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="me noopener" target="_blank">{% render 'icon', name: 'tiktok', size: 18 %}</a>
          {%- endif -%}
          {%- if settings.whatsapp_number != blank -%}
            <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" aria-label="WhatsApp" rel="noopener" target="_blank">{% render 'icon', name: 'whatsapp', size: 18 %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- comment -%} A menu handle that was never created would otherwise
                 render a heading above an empty list on every page. {%- endcomment -%}
            {%- assign fmenu = linklists[block.settings.menu] -%}
            {%- if fmenu.links.size > 0 -%}
              <div {{ block.shopify_attributes }}>
                <h4>{{ block.settings.heading }}</h4>
                <ul>
                  {%- for link in fmenu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when 'contact' -%}
            {%- comment -%}
              The address, phone and rating carry data-gp hooks: whatever is
              typed under Shop details renders first, and google-place.js
              replaces it with the live Business Profile values once they
              arrive. The address is a link, so tapping it opens Google Maps
              rather than making somebody copy a street name.
            {%- endcomment -%}
            {%- liquid
              assign maps_url = settings.google_maps_url | default: '#'
              assign has_gp = false
              if settings.google_place_id != blank and settings.google_maps_key != blank
                assign has_gp = true
              endif
            -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <ul>
                <li>
                  <a data-gp="maps" href="{{ maps_url }}" target="_blank" rel="noopener">
                    <span data-gp="address">
                      {%- if settings.address_street != blank -%}{{ settings.address_street }}, {% endif -%}
                      {{ settings.address_city | default: 'Beirut' }}
                      {%- if settings.address_country != blank %}, {{ settings.address_country }}{% endif -%}
                    </span>
                    {% render 'icon', name: 'arrow' %}
                  </a>
                </li>
                {%- if settings.phone != blank or has_gp -%}
                  <li><a data-gp="phone" href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a></li>
                {%- endif -%}
                {%- if settings.email != blank -%}
                  <li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li style="margin-top:.6rem;opacity:.75">{{ block.settings.hours }}</li>
                {%- endif -%}
              </ul>

              {%- if has_gp or settings.google_rating != blank -%}
                <a class="gbadge" data-gp="maps" href="{{ maps_url }}" target="_blank" rel="noopener"
                   style="margin-top:.9rem">
                  <span data-gp="stars">
                    {%- if settings.google_rating != blank -%}
                      <span class="gstars" role="img" aria-label="{{ settings.google_rating }} out of 5">
                        <span class="gstars__bg">★★★★★</span>
                        <span class="gstars__fg" style="width:{{ settings.google_rating | times: 20.0 }}%">★★★★★</span>
                      </span>
                    {%- endif -%}
                  </span>
                  <strong data-gp="rating">{{ settings.google_rating }}</strong>
                  <span>on Google</span>
                  <span class="gbadge__n">(<span data-gp="count">{{ settings.google_review_count }}</span>)</span>
                </a>
              {%- endif -%}
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <p style="font-size:.92rem">{{ block.settings.text }}</p>
              {% form 'customer' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter">
                  <label class="visually-hidden" for="footer-email">Email</label>
                  <input id="footer-email" type="email" name="contact[email]" placeholder="Your email" required>
                  <button class="btn btn--light btn--sm" type="submit">Join</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p style="color:var(--brass);font-size:.85rem;margin-top:.75rem">Thank you — you are on the list.</p>
                {%- endif -%}
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}

    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "About text",
      "default": "A music shop in Beirut. Arabic percussion and ouds beside guitars, amplification and studio gear — every instrument checked on the bench before it goes out the door." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ]},
    { "type": "contact", "name": "Contact", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
      { "type": "textarea", "id": "hours", "label": "Opening hours", "default": "Mon–Sat, 9:00–19:00" }
    ]},
    { "type": "newsletter", "name": "Newsletter", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Vintage accordions and one-off ouds go quickly. We email when something good lands." }
    ]}
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
