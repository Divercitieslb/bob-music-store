<div class="announce">
  <div class="wrap">
    <div class="announce__inner">
      {%- for block in section.blocks limit: 1 -%}
        <span {{ block.shopify_attributes }}>
          {%- if block.settings.url != blank -%}
            <a href="{{ block.settings.url }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free delivery across Lebanon on orders over $150" },
      { "type": "url", "id": "url", "label": "Link" }
    ]}
  ],
  "default": { "blocks": [ { "type": "message" } ] },
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
