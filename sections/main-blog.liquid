<section class="section section--tight">
  <div class="wrap">
    <p class="eyebrow">{{ blog.articles_count }} article{% if blog.articles_count != 1 %}s{% endif %}</p>
    <h1 class="h1">{{ blog.title }}</h1>
    <div style="margin-top:1.5rem">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>
  </div>
</section>

<div class="wrap" style="padding-bottom:clamp(3rem,6vw,5rem)">
  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <article class="card" data-reveal>
            <a class="card__media" href="{{ article.url }}">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}"
                     alt="{{ article.image.alt | escape | default: article.title | escape }}"
                     width="800" height="800" loading="lazy" style="object-fit:cover">
              {%- else -%}
                <div class="look__placeholder tile-bg"></div>
              {%- endif -%}
            </a>
            <div class="card__body">
              <p class="card__vendor">{{ article.published_at | date: format: 'date' }}</p>
              <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              {%- if article.excerpt_or_content != blank -%}
                <p style="font-size:.92rem;color:var(--ink-60)">
                  {{ article.excerpt_or_content | strip_html | truncate: 130 }}
                </p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="is-current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty">
        <h2 class="h2">Nothing written yet</h2>
        <p class="lede" style="margin-inline:auto">When we have something worth saying about an instrument, it will appear here.</p>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog" }
{% endschema %}
