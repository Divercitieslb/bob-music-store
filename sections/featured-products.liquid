{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
-%}

<section class="section {{ section.settings.bg }}" data-tabs>
  <div class="wrap">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h1" data-split>{{ section.settings.heading }}</h2>
          <div class="sec-wave">{% render 'illustration', name: 'soundwave-line', tone: 'brass', size: 18 %}</div>
      </div>
      {%- if section.settings.link_url != blank -%}
        <a class="link-arrow" href="{{ section.settings.link_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    {%- if tabs.size > 1 -%}
      <div class="chiprow" role="tablist" style="margin-bottom:2rem">
        {%- for block in tabs -%}
          <button class="chip" role="tab" type="button"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  aria-controls="panel-{{ block.id }}" id="tab-{{ block.id }}"
                  data-tab {{ block.shopify_attributes }}>
            {{ block.settings.label | default: block.settings.collection.title }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in tabs -%}
      {%- assign col = block.settings.collection -%}
      {%- comment -%}
        Non-first panels ship hidden so the correct one is on screen at first
        paint. Waiting for theme.js to collapse them meant every tab's products
        rendered first and the page jumped; and while `p.hidden = true` was
        being set correctly, `.grid{display:grid}` outranked the UA stylesheet's
        [hidden] rule, so they never actually went away. base.css now carries an
        author-origin [hidden] rule, and restores every panel when .js is absent
        from <html> — so a visitor without JavaScript still reaches every tab.
      {%- endcomment -%}
      <div class="grid grid--products rail" data-reveal-stagger role="tabpanel" id="panel-{{ block.id }}"
           aria-labelledby="tab-{{ block.id }}" data-panel tabindex="0"
           {% unless forloop.first %}hidden{% endunless %}>
        {%- for product in col.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          {%- comment -%}
            No placeholder cards here. Rendering fake "Example product" tiles put
            invented products on a live storefront whenever a collection setting
            did not resolve — which is exactly when the merchant most needs to
            see that something is wrong.
          {%- endcomment -%}
          <div class="tab-empty">
            <p class="mono">Nothing in this collection yet</p>
            {%- if request.design_mode -%}
              <p>Pick a collection for this tab in the sidebar. If you have chosen
                one and it is still empty, its handle may have changed — check
                Products &rarr; Collections.</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "range", "id": "count", "label": "Products per tab", "min": 4, "max": 16, "step": 2, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "select", "id": "bg", "label": "Background", "default": "",
      "options": [
        { "value": "", "label": "White" },
        { "value": "section--shell", "label": "Shell" }
      ] }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Tab label" }
    ]}
  ],
  "presets": [{ "name": "Featured products", "blocks": [ {"type":"tab"},{"type":"tab"},{"type":"tab"} ] }]
}
{% endschema %}
