<div class="wrap" style="min-height:80vh;display:grid;place-items:center;text-align:center;padding-block:clamp(3rem,10vw,7rem)">
  <div style="max-width:520px">
    <img src="{{ 'logo-header.png' | asset_url }}" alt="{{ shop.name }}"
         width="1139" height="732" style="width:min(260px,70vw);margin:0 auto 2rem">
    <h1 class="h2">Opening soon</h1>
    <p class="lede" style="margin:1rem auto 0">
      {{ shop.name }} is putting the last instruments on the wall. Come back shortly.
    </p>
    <div style="margin:1.75rem 0">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label class="field" style="text-align:left"><span>Enter the password</span>
        <input type="password" name="password" autocomplete="current-password"></label>
      <button class="btn btn--full" type="submit">Enter</button>
    {% endform %}
  </div>
</div>

{% schema %}
{ "name": "Password" }
{% endschema %}
