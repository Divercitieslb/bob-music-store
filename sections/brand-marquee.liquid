{%- liquid
  assign names = section.settings.brands | split: ','
-%}
{%- comment -%}
  WCAG 2.2.2: motion that starts automatically and runs beyond five seconds
  needs a mechanism to pause it. prefers-reduced-motion does not satisfy this.
{%- endcomment -%}
<style>
  .marquee{position:relative}
  /* The track scrolls underneath the control, so brand names ran into the
     label. A short fade of the section's own background clears a lane for it. */
  .marquee::after{
    content:'';position:absolute;top:0;right:0;bottom:0;width:clamp(96px,12vw,168px);
    background:linear-gradient(90deg,rgba(251,248,242,0),var(--paper) 62%);
    pointer-events:none;z-index:2;
  }
  .marquee.section--shell::after{background:linear-gradient(90deg,rgba(245,239,228,0),var(--shell) 62%)}
  .marquee.section--bone::after{background:linear-gradient(90deg,rgba(239,230,214,0),var(--bone) 62%)}
  .marquee.section--ink::after{background:linear-gradient(90deg,rgba(20,16,12,0),var(--ink) 62%)}

  .marquee__pause{
    position:absolute;top:50%;right:.75rem;transform:translateY(-50%);z-index:3;
    display:inline-flex;align-items:center;gap:.45rem;
    padding:.4rem .7rem;min-height:24px;min-width:24px;
    border:1px solid var(--rule-strong);background:var(--paper);
    font-family:var(--f-sans);font-size:.58rem;font-weight:700;
    letter-spacing:.16em;text-transform:uppercase;color:var(--ink-60);
    opacity:.75;transition:opacity var(--t-fast),color var(--t-fast);
  }
  .marquee__pause:hover,.marquee__pause:focus-visible{opacity:1;color:var(--ink)}
  .marquee__pause-text{display:none}
  @media(min-width:620px){.marquee__pause-text{display:inline}}
  .marquee__pause-icon{
    width:8px;height:9px;border-left:2.5px solid var(--ink);border-right:2.5px solid var(--ink);
  }
  .marquee__pause[aria-pressed=true] .marquee__pause-icon{
    width:0;height:0;border:0;
    border-left:8px solid var(--ink);border-top:5px solid transparent;border-bottom:5px solid transparent;
  }
  .marquee__track.is-paused{animation-play-state:paused}
  .marquee.section--ink .marquee__pause{background:var(--ink);border-color:rgba(239,230,214,.3)}
  .marquee.section--ink .marquee__pause-icon{border-color:var(--bone)}
</style>
<section class="marquee {{ section.settings.bg }}" aria-label="{{ section.settings.label }}">
  {%- if section.settings.label != blank -%}
    <p class="eyebrow marquee__label">{{ section.settings.label }}</p>
  {%- endif -%}
  {%- comment -%}
    WCAG 2.2.2 requires a way to stop motion that starts on its own and runs past
    five seconds. Labelled rather than a bare glyph, because an unexplained icon
    on a scrolling strip reads as decoration.
  {%- endcomment -%}
  <button class="marquee__pause" type="button" data-marquee-pause
          aria-pressed="false" aria-label="Pause the scrolling brand list"
          title="Pause the scrolling brand list">
    <span class="marquee__pause-icon" aria-hidden="true"></span>
    <span class="marquee__pause-text" data-pause-label>Pause</span>
  </button>
  <div class="marquee__track" aria-hidden="true">
    {%- for pass in (1..2) -%}
      {%- for n in names -%}
        <span>{{ n | strip }}</span>
        {% render 'ornament', name: 'khatam', size: 11, tone: 'brass' %}
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <div class="marquee__wave" aria-hidden="true">
    {% render 'illustration', name: 'soundwave-line', tone: 'brass', size: 14 %}
  </div>
  <span class="visually-hidden">{{ section.settings.brands }}</span>
</section>

<script>
  (function () {
    var s = document.currentScript && document.currentScript.previousElementSibling;
    var sec = document.querySelector('.marquee');
    if (!sec) return;
    var btn = sec.querySelector('[data-marquee-pause]');
    var track = sec.querySelector('.marquee__track');
    if (!btn || !track) return;
    var label = btn.querySelector('[data-pause-label]');
    btn.addEventListener('click', function () {
      // motion.js may have taken the track over and disabled the CSS keyframe;
      // it watches for this same class, so one toggle covers both cases.
      var paused = track.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      var text = paused ? 'Resume the scrolling brand list'
                        : 'Pause the scrolling brand list';
      btn.setAttribute('aria-label', text);
      btn.setAttribute('title', text);
      if (label) label.textContent = paused ? 'Play' : 'Pause';
    });
  })();
</script>

{% schema %}
{
  "name": "Brand marquee",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Brands we carry" },
    { "type": "textarea", "id": "brands", "label": "Brands", "info": "Comma separated.",
      "default": "Fender · Shure · BOSS · Roland · Yamaha · Audio-Technica · Epiphone · Squier · Laney · Behringer · Korg · M-Audio · D'Addario · Joyo · Mooer · Celestion · Hohner · Weltmeister · Paolo Soprani · Gawharet El Fan · Alam Alikaa · Power Beat" },
    { "type": "select", "id": "bg", "label": "Background", "default": "",
      "options": [
        { "value": "", "label": "White" },
        { "value": "section--shell", "label": "Shell" },
        { "value": "section--ink", "label": "Ink" }
      ] }
  ],
  "presets": [{ "name": "Brand marquee" }]
}
{% endschema %}
