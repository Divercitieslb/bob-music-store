<section class="section section--tight">
  <div class="wrap wrap--narrow">
    <h1 class="h1">{{ page.title }}</h1>
    {% render 'ornament', name: 'divider', tone: 'brass' %}
  </div>
</section>
<div class="wrap wrap--narrow" style="padding-bottom:clamp(3rem,7vw,6rem)">
  <div class="rte">{{ page.content }}</div>
</div>
{% schema %}
{ "name": "Page" }
{% endschema %}
