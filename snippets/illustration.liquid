{%- comment -%} sync-check 2 {%- endcomment -%}
{%- comment -%}
  Bob Music Store — inline SVG illustration set.
  Same contract as snippets/ornament.liquid: a case on `name`, a `tone` that maps to a
  brand hex, a `size`, everything aria-hidden and unfocusable, no raster, no text.

    name: 'rosette-draw'     — 12-fold pierced oud rosette, draws itself on .is-in
          'waveform'         — equaliser bars, animates on .is-playing
          'soundwave-line'   — seamless tiling sine divider
          'arabesque-corner' — corner flourish for framing panels
          'darbuka-outline'  — darbuka in profile, line drawing
          'oud-outline'      — oud in profile, line drawing
          'tile-pattern'     — seamless 8-point star tessellation (SVG <pattern>)
          'plectrum'         — risha, usable as a bullet / list marker

    tone: 'brass' (default) | 'oud' | 'ink' | 'bone' | 'current'
    size: pixel size. For the three full-bleed names ('soundwave-line', 'tile-pattern',
          'waveform') this is the HEIGHT and the width comes from the container.
          Each name carries its own sensible default.
    uid:  optional suffix for generated <pattern> / <defs> ids. Defaults to the tone.
          Only matters if you render two tessellations of the same tone on one page.
    opacity: 'tile-pattern' only — default 0.28. It is a background panel, so it is
          drawn faint; push it to 0.5+ only on a small accent block.

  EXAMPLES (wrap each line in Liquid tag delimiters; they are written bare here so that
  nothing inside this comment is ever tokenised)
    render 'illustration', name: 'oud-outline', tone: 'brass', size: 240
    render 'illustration', name: 'tile-pattern', tone: 'bone', size: 420, opacity: 0.2

  MOTION
    Nothing animates on its own. Two opt-in hooks:
      .ill-rosette  → add .is-in       (IntersectionObserver) to draw the rosette
      .ill-eq       → add .is-playing  to run the equaliser
    Both branches ship their own prefers-reduced-motion kill switch, because the
    global rule in base.css only clamps duration to .01ms — for a looping keyframe
    that is a strobe, not a stop, so we set animation:none explicitly.
    The rosette's hidden start state lives inside @media (scripting: enabled), so with
    JavaScript off the artwork renders fully drawn instead of vanishing.
{%- endcomment -%}

{%- liquid
  assign t = tone | default: 'brass'
  case t
    when 'brass'   then assign c = '#B0854A'
    when 'oud'     then assign c = '#6C4824'
    when 'ink'     then assign c = '#14100C'
    when 'bone'    then assign c = '#EFE6D6'
    else                assign c = 'currentColor'
  endcase
  assign u = uid | default: t
-%}

{%- case name -%}

{%- when 'rosette-draw' -%}
  {%- assign s = size | default: 200 -%}
  <style>
    .ill-rosette .ill-draw{stroke-dasharray:100;stroke-dashoffset:0;
      transition:stroke-dashoffset 1.5s cubic-bezier(.16,1,.3,1);
      transition-delay:calc(var(--i,0) * .11s)}
    @media (scripting: enabled){
      .ill-rosette:not(.is-in) .ill-draw{stroke-dashoffset:100}
    }
    .no-js .ill-rosette .ill-draw{stroke-dashoffset:0}
    .ill-rosette.is-in .ill-draw{stroke-dashoffset:0}
    @media (prefers-reduced-motion:reduce){
      .ill-rosette .ill-draw{stroke-dashoffset:0!important;transition:none!important}
    }
  </style>
  <svg class="ill ill-rosette" width="{{ s }}" height="{{ s }}" viewBox="0 0 200 200" fill="none"
       stroke="{{ c }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle class="ill-draw" style="--i:0" cx="100" cy="100" r="92" pathLength="100" stroke-width="1.4"/>
    <path class="ill-draw" style="--i:1" pathLength="100" stroke-width="1.6"
          d="M100 22 L139 167.55 L32.45 61 L178 100 L32.45 139 L139 32.45 L100 178 L61 32.45 L167.55 139 L22 100 L167.55 61 L61 167.55 Z"/>
    <path class="ill-draw" style="--i:2" pathLength="100" stroke-width="1.2" opacity=".85"
          d="M100 44 L148.5 72 L148.5 128 L100 156 L51.5 128 L51.5 72 Z"/>
    <path class="ill-draw" style="--i:3" pathLength="100" stroke-width="1.2" opacity=".85"
          d="M128 51.5 L156 100 L128 148.5 L72 148.5 L44 100 L72 51.5 Z"/>
    <path class="ill-draw" style="--i:4" pathLength="100" stroke-width="1" opacity=".6"
          d="M100 74 L100 56 M113 77.48 L122 61.89 M122.52 87 L138.11 78 M126 100 L144 100 M122.52 113 L138.11 122 M113 122.52 L122 138.11 M100 126 L100 144 M87 122.52 L78 138.11 M77.48 113 L61.89 122 M74 100 L56 100 M77.48 87 L61.89 78 M87 77.48 L78 61.89"/>
    <circle class="ill-draw" style="--i:5" cx="100" cy="100" r="26" pathLength="100" stroke-width="1.4"/>
    <circle class="ill-draw" style="--i:6" cx="100" cy="100" r="9" pathLength="100" stroke-width="1.4"/>
  </svg>

{%- when 'waveform' -%}
  {%- assign s = size | default: 64 -%}
  {%- assign amps = '5,9,15,8,19,25,15,9,20,27,17,11,6,13,22,17,8,5,12,20,26,16,10,7,14,22,28,19,12,6,10,16,24,18,9,5,11,19,13,7,15,9,6,11,7,4' | split: ',' -%}
  <style>
    .ill-eq__bar{transform-box:fill-box;transform-origin:center}
    @keyframes ill-eq{0%,100%{transform:scaleY(.34)}50%{transform:scaleY(1)}}
    .ill-eq.is-playing .ill-eq__bar{
      animation:ill-eq var(--d,1s) cubic-bezier(.45,0,.55,1) infinite;
      animation-delay:var(--dl,0s)}
    @media (prefers-reduced-motion:reduce){
      .ill-eq .ill-eq__bar{animation:none!important;transform:none!important}
    }
  </style>
  {%- comment -%}
    Sized by its own 240:64 aspect rather than width="100%". With width:100% + `meet` the
    bars would sit at natural size in a centred island with dead gutters either side; with
    `none` they would fatten horizontally. Declaring the intrinsic width and letting CSS
    shrink it keeps the bar rhythm exactly as drawn at every width.
  {%- endcomment -%}
  {%- assign w = s | times: 3.75 -%}
  <svg class="ill ill-eq" width="{{ w }}" height="{{ s }}" viewBox="0 0 240 64" fill="{{ c }}"
       style="max-width:100%;height:auto" aria-hidden="true" focusable="false">
    {%- for a in amps -%}
      {%- liquid
        assign x = forloop.index0 | times: 5 | plus: 5
        assign hh = a | times: 2
        assign y = 32 | minus: a
        assign m = forloop.index0 | modulo: 5
        assign d = m | times: 0.15 | plus: 0.82
        assign n = forloop.index0 | modulo: 7
        assign dl = n | times: 0.09
      -%}
      <rect class="ill-eq__bar" style="--d:{{ d }}s;--dl:-{{ dl }}s" x="{{ x }}" y="{{ y }}" width="2.8" height="{{ hh }}" rx="1.4"/>
    {%- endfor -%}
  </svg>

{%- when 'soundwave-line' -%}
  {%- assign s = size | default: 48 -%}
  <div class="ill-wave" style="--ill-h:{{ s }}px" role="presentation">
    {%- comment -%}
      preserveAspectRatio="none" is deliberate, not laziness. `slice` (the convention in
      ornament.liquid's band) crops vertically the moment the container is wider than the
      viewBox, which decapitates the wave crests. `none` locks the y-scale to the declared
      height so the crests can never clip; the wave simply stretches in x. The stroke is
      held to a true 1.4px by vector-effect, so the non-uniform scale never fattens it.
    {%- endcomment -%}
    <svg width="100%" height="{{ s }}" viewBox="0 0 960 48" fill="none"
         preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="ill-wave-{{ u }}" width="240" height="48" patternUnits="userSpaceOnUse">
          <path d="M0 24 C9.36 13.36 16.64 13.36 26 24 C38.24 42.62 47.76 42.62 60 24 C67.92 14.69 74.08 14.69 82 24 C95.68 45.28 106.32 45.28 120 24 C133.68 10.7 144.32 10.7 158 24 C165.92 30.65 172.08 30.65 180 24 C192.24 6.71 201.76 6.71 214 24 C223.36 34.64 230.64 34.64 240 24"
                stroke="{{ c }}" stroke-width="1.4" stroke-linecap="round" fill="none"
                vector-effect="non-scaling-stroke"/>
        </pattern>
      </defs>
      <rect width="960" height="48" fill="url(#ill-wave-{{ u }})"/>
    </svg>
  </div>

