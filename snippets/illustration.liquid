{%- when 'tile-pattern' -%}
  {%- assign s = size | default: 320 -%}
  {%- assign op = opacity | default: 0.28 -%}
  <div class="ill-tile" style="--ill-h:{{ s }}px" role="presentation">
    <svg width="100%" height="{{ s }}" viewBox="0 0 480 480" fill="none"
         preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <path id="ill-star-{{ u }}"
              d="M40 24 L35.32 28.69 L35.31 35.31 L28.69 35.32 L24 40 L19.31 35.32 L12.69 35.31 L12.68 28.69 L8 24 L12.68 19.31 L12.69 12.69 L19.31 12.68 L24 8 L28.69 12.68 L35.31 12.69 L35.32 19.31 Z"/>
        <pattern id="ill-tile-{{ u }}" width="48" height="48" patternUnits="userSpaceOnUse">
          <g stroke="{{ c }}" stroke-width="1.1" fill="none" stroke-linejoin="round">
            <use href="#ill-star-{{ u }}"/>
            <use href="#ill-star-{{ u }}" transform="translate(-24,-24)"/>
            <use href="#ill-star-{{ u }}" transform="translate(24,-24)"/>
            <use href="#ill-star-{{ u }}" transform="translate(-24,24)"/>
            <use href="#ill-star-{{ u }}" transform="translate(24,24)"/>
            <path d="M31 0 L24 7 L17 0 L24 -7 Z"/>
            <path d="M31 48 L24 55 L17 48 L24 41 Z"/>
            <path d="M0 17 L7 24 L0 31 L-7 24 Z"/>
            <path d="M48 17 L55 24 L48 31 L41 24 Z"/>
            <circle cx="24" cy="24" r="3.4" fill="{{ c }}" stroke="none"/>
            <circle cx="0" cy="0" r="3.4" fill="{{ c }}" stroke="none"/>
            <circle cx="48" cy="0" r="3.4" fill="{{ c }}" stroke="none"/>
            <circle cx="0" cy="48" r="3.4" fill="{{ c }}" stroke="none"/>
            <circle cx="48" cy="48" r="3.4" fill="{{ c }}" stroke="none"/>
          </g>
        </pattern>
      </defs>
      <rect width="480" height="480" fill="url(#ill-tile-{{ u }})" opacity="{{ op }}"/>
    </svg>
  </div>

{%- when 'plectrum' -%}
  {%- assign s = size | default: 24 -%}
  <svg class="ill ill-plectrum" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none"
       aria-hidden="true" focusable="false">
    {%- comment -%}
      A single solid silhouette, no light-coloured overlay and no knockout: a risha is a
      strip of horn, and at 16px bullet size any interior detail collapses into a smudge.
      The blade is bowed — the tip sits right of the head — so it reads as a plectrum
      rather than a leaf.
    {%- endcomment -%}
    <path d="M12 1.8 C15.4 3.5 16.4 7 15.4 11.2 C14.7 15 14.1 18.8 13.6 22.4 C11.9 19 10.2 15 9.2 11.2 C8.1 7 8.6 3.5 12 1.8 Z"
          fill="{{ c }}"/>
  </svg>

{%- endcase -%}
