{%- comment -%} sync-check 2 {%- endcomment -%}
{%- comment -%}
  Levantine ornament set, lifted from the logo.
    name: 'khatam'   — the eight-point star (rub el hizb) used as a full stop
          'divider'  — rule + star, as under MUSIC STORE in the wordmark
          'band'     — repeating interlaced border, as on the riq rim
          'corner'   — arabesque corner flourish
    tone: 'brass' (default) | 'oud' | 'ink' | 'bone' | 'current'
{%- endcomment -%}

{%- liquid
  assign t = tone | default: 'brass'
  case t
    when 'brass'   then assign c = '#B0854A'
    when 'oud'     then assign c = '#6C4824'
    when 'ink'     then assign c = '#14100C'
    when 'bone'    then assign c = '#EAD8C6'
    else                assign c = 'currentColor'
  endcase
-%}

{%- case name -%}

{%- when 'khatam' -%}
  {%- assign s = size | default: 18 -%}
  <svg class="orn orn--khatam" width="{{ s }}" height="{{ s }}" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
    <path d="M16 1.6 20.1 7.3 26.9 5.1 24.7 11.9 30.4 16 24.7 20.1 26.9 26.9 20.1 24.7 16 30.4 11.9 24.7 5.1 26.9 7.3 20.1 1.6 16 7.3 11.9 5.1 5.1 11.9 7.3Z" fill="{{ c }}"/>
    <path d="M16 8.4 20.2 12.6 21.6 16 20.2 19.4 16 23.6 11.8 19.4 10.4 16 11.8 12.6Z" fill="#FBF8F2" opacity=".9"/>
    <circle cx="16" cy="16" r="2.4" fill="{{ c }}"/>
  </svg>

{%- when 'divider' -%}
  <div class="orn-divider" role="presentation">
    <span class="orn-divider__rule"></span>
    <svg width="60" height="18" viewBox="0 0 60 18" fill="none" aria-hidden="true" focusable="false">
      <path d="M0 9h14" stroke="{{ c }}" stroke-width="1"/>
      <path d="M46 9h14" stroke="{{ c }}" stroke-width="1"/>
      <path d="M19 9 23 5 27 9 23 13Z" fill="{{ c }}" opacity=".75"/>
      <path d="M33 9 37 5 41 9 37 13Z" fill="{{ c }}" opacity=".75"/>
      <path d="M30 2.2 32.6 5.6 36.6 4.4 35.4 8.4 38.8 11 35.4 13.6 36.6 17.6 32.6 16.4 30 19.8 27.4 16.4 23.4 17.6 24.6 13.6 21.2 11 24.6 8.4 23.4 4.4 27.4 5.6Z"
            fill="{{ c }}" transform="translate(0,-2) scale(1)"/>
    </svg>
    <span class="orn-divider__rule"></span>
  </div>

{%- when 'band' -%}
  {%- assign hgt = size | default: 22 -%}
  <div class="orn-band" style="--orn-h:{{ hgt }}px" role="presentation">
    <svg width="100%" height="{{ hgt }}" viewBox="0 0 96 24" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="orn-band-{{ tone }}" width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M12 1 23 12 12 23 1 12Z" fill="none" stroke="{{ c }}" stroke-width="1.4"/>
          <path d="M12 6.5 17.5 12 12 17.5 6.5 12Z" fill="{{ c }}" opacity=".55"/>
          <path d="M0 12h2M22 12h2M12 0v2M12 22v2" stroke="{{ c }}" stroke-width="1.4"/>
        </pattern>
      </defs>
      <rect width="96" height="24" fill="url(#orn-band-{{ tone }})"/>
    </svg>
  </div>

{%- when 'corner' -%}
  {%- assign s = size | default: 64 -%}
  <svg class="orn orn--corner" width="{{ s }}" height="{{ s }}" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
    <path d="M2 2h20M2 2v20" stroke="{{ c }}" stroke-width="1.4"/>
    <path d="M8 8h9M8 8v9" stroke="{{ c }}" stroke-width="1" opacity=".6"/>
    <path d="M2 30c14 0 26-12 26-28" stroke="{{ c }}" stroke-width="1" opacity=".45" fill="none"/>
    <path d="M14 14 20 8l6 6-6 6Z" fill="{{ c }}" opacity=".5"/>
  </svg>

{%- endcase -%}
