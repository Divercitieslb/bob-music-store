<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#14100C">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Karla:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'motion.css' | asset_url }}">

  <script>
    document.documentElement.classList.add('js');
    window.Shop = {
      money: {{ shop.money_format | json }},
      routes: {
        cart_add: '{{ routes.cart_add_url }}',
        cart_change: '{{ routes.cart_change_url }}',
        cart: '{{ routes.cart_url }}',
        predictive: '{{ routes.predictive_search_url }}'
      },
      enquiryOnly: {{ settings.enquiry_only | default: false | json }},
      whatsapp: {{ settings.whatsapp_number | default: '' | json }}
    };
  </script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip-link" href="#main">Skip to content</a>

  {% sections 'header-group' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'motion.js' | asset_url }}" defer></script>

  {%- comment -%}
    Live Google Business Profile data. Loaded only when both values are set, so
    the script is never fetched on a store that has not configured it. The key
    is public by design — a Maps Platform browser key is protected by its HTTP
    referrer restriction, not by being hidden.
  {%- endcomment -%}
  {%- if settings.google_place_id != blank and settings.google_maps_key != blank -%}
    <script>
      window.BOB_GOOGLE_PLACE = {
        placeId: {{ settings.google_place_id | json }},
        key: {{ settings.google_maps_key | json }}
      };
    </script>
    <script src="{{ 'google-place.js' | asset_url }}" defer></script>
  {%- endif -%}
</body>
</html>
