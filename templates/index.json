    "oud_room": {
      "type": "split-feature",
      "settings": {
        "collection": "oud",
        "flip": false,
        "eyebrow": "The oud room",
        "heading": "An instrument you choose by ear",
        "text": "<p>Every oud we stock is built by hand, so no two sound the same. A blonde spruce top speaks quickly and cuts through a room. A darker cedar top gives you warmth and a longer decay. The bowl — walnut, mahogany, or ribbed maple — decides how much of that sound comes back at you.</p><p>Come and play them. We will string it to your preference and set the action before it leaves.</p>",
        "image_alt": "A handmade oud on the workbench",
        "stat_1": "11",
        "stat_1_label": "Ouds in stock",
        "stat_2": "3",
        "stat_2_label": "Countries of origin",
        "stat_3": "1",
        "stat_3_label": "Of each, exactly",
        "cta_label": "See the ouds",
        "cta_url": "/collections/oud",
        "bg": "section--shell",
        "default_asset": "feature-oud.jpg",
