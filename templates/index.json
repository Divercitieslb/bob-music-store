    "percussion": {
      "type": "split-feature",
      "settings": {
        "collection": "percussion",
        "flip": true,
        "eyebrow": "Arabic percussion",
        "heading": "The rhythm section of a whole region",
        "text": "<p>Darbuka, riq, tabl and bendir — the instruments that carry Arabic music. Our darbukas come from workshops that still inlay mother-of-pearl by hand, one tessera at a time, which is why the shells in the photographs are the shells you receive.</p><p>All are bolt-tuned with synthetic heads, so they hold pitch through a Beirut summer and through a flight.</p>",
        "image_alt": "Mother-of-pearl inlay on a darbuka shell",
        "cta_label": "Shop percussion",
        "cta_url": "/collections/percussion",
        "bg": "section--ink",
        "default_asset": "feature-percussion.jpg",
        "watermark": "darbuka-outline"
      }
