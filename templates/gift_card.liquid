<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} gift card</title>
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Karla:wght@400;600&family=Space+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <div class="wrap" style="max-width:520px;padding-block:clamp(2.5rem,7vw,5rem);text-align:center">
    <img src="{{ 'logo-header.png' | asset_url }}" alt="{{ shop.name }}"
         width="1139" height="732" style="width:min(220px,60vw);margin:0 auto 2rem">

    <p class="eyebrow">Gift card</p>
    <h1 class="h2">{{ gift_card.balance | money }}</h1>
    <div style="margin:1.5rem 0">{% render 'ornament', name: 'divider', tone: 'brass' %}</div>

    {%- if gift_card.expired -%}
      <p class="note">This gift card has expired.</p>
    {%- elsif gift_card.expires_on -%}
      <p style="color:var(--ink-60)">Valid until {{ gift_card.expires_on | date: format: 'date' }}</p>
    {%- endif -%}

    <div style="background:var(--shell);padding:2rem 1.5rem;margin:2rem 0">
      {{ gift_card.qr_identifier }}
      <p class="num" style="font-size:1.15rem;letter-spacing:.16em;margin:1rem 0 0">
        {{ gift_card.code | format_code }}
      </p>
    </div>

    <p style="color:var(--ink-60);font-size:.92rem">
      Use this code at checkout, or show it at the counter in Beirut.
    </p>
    <a class="btn" href="{{ shop.url }}" style="margin-top:1.25rem">Shop the catalogue</a>
  </div>
</body>
</html>
