# Shopify reads theme files as-is. Windows checkouts were introducing CRLF into
# JSON templates and Liquid, which is one more variable than this needs.
* text=auto eol=lf
*.liquid  text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.png     binary
*.jpg     binary
*.svg     text eol=lf
*.zip     binary
